[ccpp-table-properties]
  name = simple_sub
  type = host
[ccpp-arg-table]
  name = simple_sub
  type = host
[ pcols ]
  standard_name = horizontal_dimension
  type = integer
  units = count
  dimensions = ()
  protected = True
[ dtime_phys ]
  standard_name = timestep_for_physics
  type = real | kind = kind_phys
  units = s
  dimensions = ()
  protected = True
[ pver ]
  standard_name = vertical_layer_dimension
  long_name = number of vertical layers
  units = count
  dimensions = ()
  type = integer
  protected = True
[ theta ]
  standard_name = potential_temperature
  units = K
  type = real | kind = kind_phys
  dimensions = (horizontal_dimension, vertical_layer_dimension)
